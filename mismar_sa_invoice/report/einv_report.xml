<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_saudi_invoice_document">
        <t t-set="o" t-value="o.with_context(lang=lang)"/>
        <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
        <t t-set="o_sec" t-value="o.with_context(lang=o.env['res.lang']._get_code('ar_001'))"/>
        <t t-set="o" t-value="o.with_context(lang='en_US')"/>
        <t t-set="company" t-value="o.company_id"/>

        <div class="article"
             style="font-family: Arial, sans-serif;"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
        <div class="page" style="font-size: 12px; line-height: 1.1;">

            <!-- Shared letterhead — defined ONCE in
                 mismar_reporting_template.inline_letterhead and reused by both the
                 invoice and the proforma, so they always stay in sync. -->
            <t t-call="mismar_reporting_template.inline_letterhead"/>

                <!-- Title Section with Invoice Number -->
                <div class="row mb-3">
                    <div class="col-12 text-center">
                        <h3 class="mb-0 ">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                                <t t-if="o._l10n_sa_is_simplified()">
                                    Simplified Tax Invoice - فاتورة ضريبية مبسطة
                                </t>
                                <t t-else="">
                                    Tax Invoice - فاتورة ضريبية
                                </t>
                            </span>
                            <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">
                                Draft Invoice - مسودة فاتورة
                            </span>
                            <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">
                                Cancelled Invoice - فاتورة ملغاة
                            </span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">
                                Credit Note - إشعار دائن
                            </span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">
                                Draft Credit Note - إشعار خصم المسودة
                            </span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">
                                Cancelled Credit Note - إشعار خصم ملغاة
                            </span>
                            <span t-elif="o.move_type == 'in_refund'">
                                Vendor Credit Note - إشعار مدين
                            </span>
                            <span t-elif="o.move_type == 'in_invoice'">
                                Vendor Bill - فاتورة المورد
                            </span>
                        </h3>
                    </div>
                </div>

                <!-- Invoice Information and QR Code Section -->
                <div class="row mb-3">
                    <!-- Invoice Information on the left -->
                    <div class="col-8">
                        <table class="table table-bordered table-sm" style="font-size: 12px;">
                            <tr t-if="o.name">
                                <td class="text-start" style="width: 30%;">
                                    <strong>Invoice No.</strong>
                                </td>
                                <td class="text-center" style="width: 30%;">
                                    <span t-field="o.name"/>
                                </td>
                                <td class="text-end" style="width: 40%;" dir="rtl">
                                    <strong>رقم الفاتورة</strong>
                                </td>
                            </tr>
                            <tr t-if="o.invoice_date">
                                <td class="text-start" style="width: 30%;">
                                    <strong>Invoice Date</strong>
                                </td>
                                <td class="text-center" style="width: 30%;">
                                    <span t-if="o.l10n_sa_confirmation_datetime"
                                          t-field="o.l10n_sa_confirmation_datetime" t-options="{'widget': 'date'}"/>
                                    <span t-else="" t-field="o.invoice_date" t-options="{'widget': 'date'}"/>
                                </td>
                                <td class="text-end" style="width: 40%;" dir="rtl">
                                    <strong>تاريخ الفاتورة</strong>
                                </td>
                            </tr>
                            <tr t-if="o.invoice_origin">
                                <td class="text-start">
                                    <strong>SO No.</strong>
                                </td>
                                <td class="text-center">
                                    <span t-field="o.invoice_origin"/>
                                </td>
                                <td class="text-end" dir="rtl">
                                    <strong>رقم أمر البيع</strong>
                                </td>
                            </tr>
                            <tr t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                                <td class="text-start">
                                    <strong>Due Date</strong>
                                </td>
                                <td class="text-center">
                                    <span t-field="o.invoice_date_due"/>
                                </td>
                                <td class="text-end" dir="rtl">
                                    <strong>تاريخ الاستحقاق</strong>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.contract_no">
                                <td class="text-start">
                                    <strong>Contract No.</strong>
                                </td>
                                <td class="text-center">
                                    <span t-field="o.partner_id.contract_no"/>
                                </td>
                                <td class="text-end" dir="rtl">
                                    <strong>رقم العقد</strong>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.quotation_no">
                                <td class="text-start">
                                    <strong>Quotation No.</strong>
                                </td>
                                <td class="text-center">
                                    <span t-field="o.partner_id.quotation_no"/>
                                </td>
                                <td class="text-end" dir="rtl">
                                    <strong>رقم عرض السعر</strong>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.po_no">
                                <td class="text-start">
                                    <strong>PO No.</strong>
                                </td>
                                <td class="text-center">
                                    <span t-field="o.partner_id.po_no"/>
                                </td>
                                <td class="text-end" dir="rtl">
                                    <strong>رقم أمر الشراء</strong>
                                </td>
                            </tr>
                            <tr t-if="o.invoice_payment_term_id">
                                <td class="text-start">
                                    <strong>Payment Terms</strong>
                                </td>
                                <td class="text-center">
                                    <span t-field="o.invoice_payment_term_id"/>
                                </td>
                                <td class="text-end" dir="rtl">
                                    <strong>الدفعات</strong>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- QR Code on the right -->
                    <div class="col-4 text-center">
                        <img t-if="o.l10n_sa_qr_code_str"
                             style="display:block; margin: 0 auto;"
                             t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', quote_plus(o.l10n_sa_qr_code_str), 140, 140)"/>
                    </div>
                </div>

                <!-- Customer Information Table -->
                <div class="row mb-3">
                    <div class="col-12">
                        <table class="table table-bordered" style="font-size: 13px;">
                            <tr>
                                <td class=" text-center"
                                    style="width: 50%; background-color: #f8f9fa; font-weight: bold; vertical-align: middle;"
                                    rowspan="2">
                                    Customer / العميل
                                </td>
                                <td class="text-center " style="font-size: 13px;width: 50%;" dir="rtl">
                                    <span t-field="o.partner_id.arabic_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="font-size: 13px;">
                                    <span t-field="o.partner_id.english_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center"
                                    style="font-size: 13px;width: 50%; background-color: #f8f9fa; font-weight: bold; vertical-align: middle;"
                                    rowspan="2">
                                    Project / المشروع
                                </td>
                                <td class="text-center " style="font-size: 13px;">
                                    <span t-field="o.partner_id.arabic_project"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="width: 50%;font-size: 13px;" dir="rtl">
                                    <span t-field="o.partner_id.english_project"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center"
                                    style="background-color: #f8f9fa; font-weight: bold; vertical-align: middle;font-size: 13px;"
                                    rowspan="2">
                                    Address / العنوان
                                </td>
                                <td class="text-center" style="font-size: 13px;" dir="rtl">
                                    <span t-field="o.partner_id.street"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-center" style="font-size: 13px;" dir="rtl">
                                    <span t-field="o.partner_id.street2"/>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.vat" style="font-size: 13px;">
                                <td class="text-center" style="background-color: #f8f9fa; font-weight: bold;">
                                    Commercial Record / السجل التجاري
                                </td>
                                <td class="text-center">
                                    <span t-field="o.partner_id.commercial_records"/>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.vat" style="font-size: 13px;">
                                <td class="text-center" style="background-color: #f8f9fa; font-weight: bold;">
                                    VAT No. / الرقم الضريبي
                                </td>
                                <td class="text-center">
                                    <span t-field="o.partner_id.vat"/>
                                </td>
                            </tr>
                            <tr t-if="o.partner_id.email" style="font-size: 13px;">
                                <td class="text-center" style="background-color: #f8f9fa; font-weight: bold;">
                                    Email / البريد الإلكتروني
                                </td>
                                <td class="text-center">
                                    <span t-field="o.partner_id.email"/>
                                </td>
                            </tr>
                            <tr style="font-size: 13px;"
                                t-if="o.partner_id.l10n_sa_additional_identification_scheme and o.partner_id.l10n_sa_additional_identification_number">
                                <td class="text-center" style="background-color: #f8f9fa; font-weight: bold;">
                                    Additional ID / هوية إضافية
                                </td>
                                <td class="text-center">
                                    <span t-field="o.partner_id.l10n_sa_additional_identification_scheme"/>:
                                    <span t-field="o.partner_id.l10n_sa_additional_identification_number"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Invoice Lines Table -->
                <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                <div class="row mb-2">
                    <div class="col-12">
                        <table class="table table-bordered"
                               style="font-size: 13px;">
                            <thead>
                                <tr style="background-color: #f8f9fa;">
                                    <th class="text-center" style="width: 15%; font-weight: bold;">
                                        Item Code
                                        <br/>
                                        كود الصنف
                                    </th>
                                    <th class="text-center" style="width: 15%; font-weight: bold;">
                                        Description
                                        <br/>
                                        الوصف
                                    </th>
                                    <th class="text-center" style="width: 8%; font-weight: bold;">
                                        Qty
                                        <br/>
                                        الكمية
                                    </th>
                                    <th class="text-center" style="width: 10%; font-weight: bold;">
                                        Unit Price
                                        <br/>
                                        سعر الوحدة
                                    </th>
                                    <th class="text-center" style="width: 7%; font-weight: bold;"
                                        t-if="display_discount">
                                        Disc.%
                                        <br/>
                                        خصم %
                                    </th>
                                    <th class="text-center" style="width: 7%; font-weight: bold;">
                                        VAT%
                                        <br/>
                                        ضريبة
                                    </th>
                                    <th class="text-center" style="width: 12%; font-weight: bold;">
                                        Amount
                                        <br/>
                                        (excl. VAT)
                                        <br/>
                                        المبلغ بدون ضريبة
                                    </th>
                                    <th class="text-center" style="width: 12%; font-weight: bold;">
                                        VAT Amount
                                        <br/>
                                        قيمة الضريبة
                                    </th>
                                    <th class="text-center" style="width: 14%; font-weight: bold;">
                                        Total
                                        <br/>
                                        (incl. VAT)
                                        <br/>
                                        المجموع شامل الضريبة
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-set="lines"
                                   t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                                <t t-foreach="lines" t-as="line">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                                    <tr t-att-class="'fw-bold' if line.display_type == 'line_section' else 'fst-italic' if line.display_type == 'line_note' else ''">
                                        <t t-if="line.display_type not in ('line_note', 'line_section')">
                                            <td class="text-center" style="padding: 4px; vertical-align: middle;">
                                                <div t-out="line.product_id.default_code" t-options="{'widget': 'text'}"
                                                     style="font-size: 13px;"
                                                     t-att-dir="o.env['res.lang']._get_data(code=o.partner_id.lang).direction"/>
                                            </td>
                                            <td class="text-start" style="padding: 4px; vertical-align: middle;">
                                                <div t-out="line.name.replace('[' + (line.product_id.default_code or '') + '] ', '') if line.product_id.default_code and line.name.startswith('[' + line.product_id.default_code + ']') else line.name"
                                                     t-options="{'widget': 'text'}"
                                                     style="font-size: 13px;"
                                                     t-att-dir="o.env['res.lang']._get_data(code=o.partner_id.lang).direction"/>
                                            </td>
                                            <td class="text-center" style="padding: 4px; vertical-align: middle;">
                                                <span t-field="line.quantity"/>
                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                            </td>
                                            <td class="text-center" style="padding: 4px; vertical-align: middle;">
                                                <span t-field="line.price_unit"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-center" style="padding: 4px; vertical-align: middle;"
                                                t-if="display_discount">
                                                <span t-field="line.discount"/>%
                                            </td>
                                            <td class="text-center" style="padding: 4px; vertical-align: middle;">
                                                <span t-out="', '.join(map(lambda x: (x.invoice_label or x.name), line.tax_ids))"/>
                                            </td>
                                            <td class="text-center" style="padding: 4px; vertical-align: middle;">
                                                <span t-field="line.price_subtotal"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-center" style="padding: 4px; vertical-align: middle;">
                                                <span t-field="line.l10n_gcc_invoice_tax_amount"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-center" style="padding: 4px; vertical-align: middle;">
                                                <span t-field="line.price_total"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </t>
                                        <t t-if="line.display_type == 'line_section'">
                                            <td colspan="99" class="text-start"
                                                style="background-color: #f8f9fa; font-weight: bold; padding: 4px;">
                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                            </td>
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subtotal" t-value="0"/>
                                        </t>
                                        <t t-if="line.display_type == 'line_note'">
                                            <td colspan="99" class="text-start fst-italic" style="padding: 4px;">
                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                            </td>
                                        </t>
                                    </tr>

                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                        <tr style="background-color: #f8f9fa;">
                                            <td colspan="99" class="text-end" style="padding: 4px;">
                                                <strong>Subtotal / الإجمالي الفرعي:</strong>
                                                <span t-out="current_subtotal"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Totals Section -->
                <div class="row mb-2">
                    <div class="col-5"></div>
                    <div class="col-7">
                        <table class="table table-bordered" style="font-size: 13px;">
                            <tr>
                                <td class="text-end" style="font-weight: bold; padding: 4px;">
                                    Invoice Taxable Amount (exclusive of VAT)
                                    <br/>
                                    المبلغ الخاضع للضريبة
                                </td>
                                <td class="text-end" style="width: 30%; padding: 4px;">
                                    <t t-set="non_retention_lines"
                                       t-value="o.invoice_line_ids.filtered(lambda l: 'retention' not in l.name.lower() and 'retantion' not in l.name.lower())"/>
                                    <t t-set="taxable_amount"
                                       t-value="sum(non_retention_lines.mapped('price_subtotal'))"/>

                                    <span t-out="taxable_amount"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>

                            <!-- Tax Details -->
                            <t t-set="tax_totals" t-value="o.tax_totals"/>
                            <t t-set="currency" t-value="o.currency_id"/>
                            <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                                <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                    <tr>
                                        <td class="text-end" style="font-weight: bold; padding: 4px;">
                                            <span t-out="tax_group['group_name']"/>
                                            <t t-set="o_sec"
                                               t-value="o.with_context(lang=o.env['res.lang']._get_code('ar_001'))"/>
                                            <t t-set="arabic_tax_group_name"
                                               t-value="o_sec.tax_totals['subtotals'][subtotal_index]['tax_groups'][tax_group_index]['group_name']"/>
                                            <t t-if="arabic_tax_group_name != tax_group['group_name']">
                                                /
                                                <span t-esc="arabic_tax_group_name"/>
                                            </t>
                                        </td>
                                        <td class="text-end" style="padding: 4px;">
                                            <span t-out="tax_group['tax_amount_currency']"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-set="retention_line"
                               t-value="o.invoice_line_ids.filtered(lambda l: 'retention' in l.name.lower() or 'retantion' in l.name.lower())"/>
                            <t t-if="retention_line">
                                <t t-set="retention_amount" t-value="sum(retention_line.mapped('price_total'))"/>
                                <tr>
                                    <td class="text-end" style="font-weight: bold; padding: 4px;">
                                        Retention / الاستبقاء
                                    </td>
                                    <td class="text-end" style="padding: 4px;">
                                        <span t-out="retention_amount"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                            <tr style="background-color: #f8f9fa;">
                                <td class="text-end" style="font-weight: bold; font-size: 13px; padding: 4px;">
                                    Invoice Total (inclusive of VAT)
                                    <br/>
                                    إجمالي قيمة الفاتورة شامل ضريبة القيمة المضافة
                                </td>
                                <td class="text-end" style="font-weight: bold; font-size: 13px; padding: 4px;">
                                    <span t-field="o.amount_total"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Bank Details -->
                <div class="row mb-2">
                    <div class="col-6" style="font-size: 11px;">
                        <t t-set="company_bank_account"
                           t-value="o.company_id.partner_id.bank_ids and o.company_id.partner_id.bank_ids[0] or False"/>
                        <table class="table table-bordered text-center">
                            <tr>
                                <td colspan="2" class="text-center"
                                    style="vertical-align: middle; font-weight: bold; padding: 4px; background-color: #f8f9fa;">
                                    Bank Details / تفاصيل البنك
                                </td>
                            </tr>
                            <tr t-if="company_bank_account">
                                <td style="vertical-align: middle;font-weight: bold; padding: 4px; width: 40%;">
                                    Bank Name<br/>اسم البنك
                                </td>
                                <td style="padding: 4px;vertical-align: middle;">
                                    <span t-field="company_bank_account.bank_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="vertical-align: middle;font-weight: bold; padding: 4px;">
                                    Beneficiary<br/>المستفيد
                                </td>
                                <td style="padding: 4px;vertical-align: middle;">
                                    <span t-field="o.company_id.partner_id.english_name"/>
                                    <br/>
                                    <span dir="rtl" t-field="o.company_id.partner_id.arabic_name"/>
                                </td>
                            </tr>
                            <tr t-if="company_bank_account">
                                <td style="vertical-align: middle;font-weight: bold; padding: 4px;">
                                    Account No.<br/>رقم الحساب
                                </td>
                                <td style="padding: 4px;vertical-align: middle;">
                                    <span t-field="company_bank_account.acc_number"/>
                                </td>
                            </tr>
                            <tr t-if="company_bank_account">
                                <td style="vertical-align: middle;font-weight: bold; padding: 4px;">
                                    IBAN<br/>الآيبان
                                </td>
                                <td style="padding: 4px;vertical-align: middle;">
                                    <span t-field="company_bank_account.iban"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-6 text-center">
                        <img class="text-left" t-if="o.company_id.invoice_stamp_sa"
                             t-att-src="image_data_uri(o.company_id.invoice_stamp_sa)"
                             style="max-height: 130px;" alt="Digital Signature"/>
                    </div>
                </div>

                <!-- Additional Information Section -->
                <div class="row" style="font-size: 13px;">
                    <!-- Amount in Words -->
                    <div class="col-6" t-if="o.company_id.display_invoice_amount_total_words">
                        <table class="table table-bordered">
                            <tr>
                                <td class="text-start" style="padding: 4px;">
                                    <strong>Total amount in words:</strong>
                                    <br/>
                                    <span t-field="o.amount_total_words" class="text-muted"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-end" dir="rtl" style="padding: 4px;">
                                    <strong>المبلغ الإجمالي بالكلمات:</strong>
                                    <br/>
                                    <span t-out="o._num2words(o.amount_total, 'ar_001')" class="text-muted"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Additional Notes -->
                <div class="row mt-1" t-if="o.narration" style="font-size: 11px;">
                    <div class="col-12">
                        <table class="table table-bordered">
                            <tr>
                                <td class="text-start" style="padding: 4px;">
                                    <small t-if="o.narration != o.with_context(lang=o.env['res.lang']._get_code('ar_001')).narration"
                                           t-out="o.narration"/>
                                </td>
                                <td class="text-end" style="padding: 4px;">
                                    <small dir="rtl"
                                           t-out="o.with_context(lang=o.env['res.lang']._get_code('ar_001')).narration"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </template>

    <!-- Main report template -->
    <template id="custom_saudi_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="mismar_sa_invoice.custom_saudi_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- Paper format: small top margin since the letterhead is now an in-flow
         block at the top of the body (not a separate wkhtmltopdf header region). -->
    <record id="paperformat_invoice_sa" model="report.paperformat">
        <field name="name">Saudi Invoice A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report record to use this template -->
    <record id="account_invoices_custom_sa" model="ir.actions.report">
        <field name="name">Saudi Vat Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mismar_sa_invoice.custom_saudi_invoice</field>
        <field name="report_file">mismar_sa_invoice.custom_saudi_invoice</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Invoice - %s' % (object.name or "Draft ").replace('/', '')</field>
        <field name="domain" eval="[('move_type', 'in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund'))]"/>
        <field name="paperformat_id" ref="paperformat_invoice_sa"/>
    </record>

</odoo>