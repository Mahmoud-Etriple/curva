<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_proforma_header" model="ir.ui.view">
        <field name="name">res.company.form.proforma.header.image</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="proforma_header_image" widget="image"
                       options="{'size': [0, 90]}"/>
            </xpath>
        </field>
    </record>
</odoo>
