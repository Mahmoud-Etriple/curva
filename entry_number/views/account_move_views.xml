<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_move_tree_entry_number" model="ir.ui.view">
        <field name="name">account.move.list.entry.number</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="entry_number" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Form -->
    <record id="view_move_form_entry_number" model="ir.ui.view">
        <field name="name">account.move.form.entry.number</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="entry_number"/>
            </xpath>
        </field>
    </record>

    <!-- Search -->
    <record id="view_account_move_filter_entry_number" model="ir.ui.view">
        <field name="name">account.move.search.entry.number</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="entry_number"/>
            </field>
        </field>
    </record>

</odoo>
