<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="res_company_application" model="ir.ui.view">
            <field name="name">res.company.application</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="invoice_signature" widget="image"/>
                </xpath>

                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="custom_image" widget="image"/>
                    <field name="custom_footer_image" widget="image"/>
                    <field name="custom_image_filename" invisible="1"/>
                    <field name="color" widget="color_picker"/>
                    <field name="primary_color" widget="color"/>
                    <field name="report_header"/>
                    <field name="font"/>
                    <field name="template_primary_color" widget="color"/>
                    <field name="templates_primary_font" widget="color"/>
                    <field name="template_secondary_color" widget="color"/>
                    <field name="templates_secondary_font" widget="color"/>
                </xpath>

            </field>
        </record>
       <record id="view_company_form_inherit_custom_accounts" model="ir.ui.view">
    <field name="name">res.company.form.inherit.custom.accounts</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='currency_id']" position="after">
            <field name="bank_ids"
                   context="{'default_company_id': id, 'default_partner_id': partner_id}">
                <list editable="bottom">
                    <field name="acc_number" required="1"/>
                    <field name="bank_id" required="1" force_save="1"/>
                    <field name="allow_out_payment"/>
                </list>

                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="acc_number" required="1"/>
                                <field name="bank_id" required="1" force_save="1"/>
                                <field name="acc_holder_name"/>
                            </group>
                            <group>
                                <field name="currency_id"/>
                                <field name="allow_out_payment"/>
                                <field name="partner_id" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </xpath>

        <xpath expr="//field[@name='color']" position="after">
            <field name="invoice_stamp" widget="image"/>
        </xpath>

        <xpath expr="//notebook" position="inside">
            <page string="Asset Accounts" name="asset_accounts">
                <group>
                    <group>
                        <field name="loss_account_id"/>
                    </group>
                    <group>
                        <field name="gain_account_id"/>
                    </group>
                </group>
            </page>
        </xpath>

    </field>
</record>
    </data>
</odoo>